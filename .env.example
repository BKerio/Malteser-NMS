EXPO_OFFLINE=1
EXPO_NO_TELEMETRY=1

# Comma-separated API bases (first reachable wins; local preferred in __DEV__).
# localhost/127.0.0.1 are rewritten for Android emulator (10.0.2.2) and
# physical devices (Expo LAN IP). Do not duplicate the same env key.
#
# EXPO_PUBLIC_API_URL=http://10.140.76.184:3000,http://127.0.0.1:3000,http://156.67.25.84:8080
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000,http://156.67.25.84:8080

# Optional — defaults to the active API URL
EXPO_PUBLIC_SOCKET_URL=

# Same key as frontend VITE_GOOGLE_MAPS_KEY (Directions + Maps SDK)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
